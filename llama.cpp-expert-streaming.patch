+        const int n_expert_used = (int) t->ne[0];
+        const int n_tokens      = (int) t->ne[1];
+        if (n_expert_used <= 0 || n_tokens <= 0) continue;
+        const int32_t * data = (const int32_t *) t->data;
+        if (!data) continue;
+        std::vector<int32_t> ids;
+        ids.reserve(n_expert_used * n_tokens);
+        for (int k = 0; k < n_expert_used * n_tokens; ++k) {
+            int32_t v = data[k];
+            if (v < 0) continue;
+            ids.push_back(v);
+        }
+        std::sort(ids.begin(), ids.end());
+        ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+        if (!ids.empty()) {
+            // LRU keep-recent bookkeeping (no-op when keep_recent == 0,
+            // checked inside notify_used).
+            if (pimpl->expert_keep_recent > 0) {
+                pimpl->expert_stream_mgr.notify_used(il, (const uint32_t *) ids.data(), ids.size());
+            }
+            // Prefetch prediction: record the per-layer expert IDs as
+            // the prediction for the next-token expert selection. The
+            // background worker (if started) will issue prefetch hints
+            // for these regions when kickoff_prefetch() is called from
+            // expert_stream_post_compute().
+            if (pimpl->expert_prefetch) {
