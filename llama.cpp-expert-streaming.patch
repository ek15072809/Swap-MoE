+// Whether expert fixation is currently pinning the routed-expert selection
+// (countdown > 0). Used to decide whether to skip LRU maintenance for this
+// token (fixation guarantees no new experts were paged in this token, so
+// there is nothing new to evict).
+bool llama_model::expert_stream_fixation_active() const {
+    return pimpl->expert_stream_init && pimpl->expert_fixation_state.remaining.load(std::memory_order_relaxed) > 0;
+}
+
+// Whether expert fixation is configured (even if the window has expired).
+// Used by llama_context::graph_params() to decide whether to hand the
+// fixation state/node-args pointers to llm_graph_context, which in turn
+// decides whether build_moe_ffn() inserts the fixation graph node at all.
+bool llama_model::expert_stream_fixation_configured() const {
+    return pimpl->expert_stream_init && pimpl->expert_fixation_state.configured;
+}
+
+// Pointer to the shared fixation runtime state, or nullptr if fixation is
+// not configured. Consumed by build_moe_ffn() via llm_graph_params.
+llama_expert_stream::fixation_state * llama_model::expert_stream_fixation_state() const {
+    if (!expert_stream_fixation_configured()) {
+        return nullptr;
+    }
+    return &pimpl->expert_fixation_state;
+}
+
+// Per-layer node-argument table (size == n_layer), or nullptr if fixation
+// is not configured. Consumed by build_moe_ffn() via llm_graph_params.
+const std::vector<llama_expert_stream::fixation_node_args> * llama_model::expert_stream_fixation_node_args() const {
+    if (!expert_stream_fixation_configured()) {
+        return nullptr;
+    }
+    return &pimpl->expert_fixation_node_args;
+}
+
+// Mark whether a warmup forward pass is in flight, so the fixation graph
+// node skips capture/override on placeholder warmup data. Called from
+// llama_context::set_warmup().
+void llama_model::expert_stream_set_warmup(bool value) const {
+    if (!pimpl->expert_stream_init) {
+        return;
+    }
+    pimpl->expert_fixation_state.warmup.store(value, std::memory_order_relaxed);
+}
+
+// Tick the fixation countdown. Called once per non-warmup graph_compute
+// (NOT once per layer -- the per-layer graph nodes all read the same
+// countdown value via fixation_state::remaining). When it reaches 0, the
+// fixation graph nodes fall back to a plain per-layer memcpy passthrough,
+// with no further bookkeeping cost.
+void llama_model::expert_stream_tick_fixation() const {
+    int32_t remaining = pimpl->expert_fixation_state.remaining.load(std::memory_order_relaxed);
+    if (remaining > 0) {
+        pimpl->expert_fixation_state.remaining.store(remaining - 1, std::memory_order_relaxed);
+        LLAMA_LOG_DEBUG("%s: expert fixation — %d forward passes remaining\n",
+            __func__, remaining - 1);
+    }
+}
